<nav class="navbar navbar-expand-lg navbar-light">
  <div class="container">
    <a class="navbar-brand me-6" href="index.html">
      <img src="/assets/images/LOGO.png" alt="logo">
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <form class="d-flex position-relative">
        <span class="material-symbols-outlined text-neutral-60 position-absolute top-50 start-0 translate-middle-y ms-3">search</span>
        <input class="form-control ps-8 search" type="search" placeholder="搜尋景點、地點或城市" aria-label="Search">
