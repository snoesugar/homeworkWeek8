<script>
  window.addEventListener("scroll", function() {
    const navbar = document.querySelector(".navbar");
    if (window.scrollY > 50) { // 滾超過 50px
      navbar.classList.add("scrolled");
    } else {
      navbar.classList.remove("scrolled");
    }
  });
</script>

<!--登入-->
<script>
// 登入 modal
const loginModal = document.querySelector("#exampleModalToggle");
const loginEmail = loginModal.querySelector(".login-email");
const loginPassword = loginModal.querySelector(".login-password");
const loginBtn = loginModal.querySelector(".loginBtn");

function toggleLoginBtn() {
  const enabled = loginEmail.value.trim() !== "" && loginPassword.value.trim() !== "";
  loginBtn.disabled = !enabled;
  if (enabled) {
    loginBtn.classList.remove("bg-neutral-40", "text-neutral-60");
    loginBtn.classList.add("bg-primary", "text-white");
  } else {
    loginBtn.classList.add("bg-neutral-40", "text-neutral-60");
    loginBtn.classList.remove("bg-primary", "text-white");
  }
}

loginEmail.addEventListener("input", toggleLoginBtn);
loginPassword.addEventListener("input", toggleLoginBtn);

// 註冊 modal
const registerModal = document.querySelector("#exampleModalToggle2");
const registerEmail = registerModal.querySelector(".register-email");
const registerPassword = registerModal.querySelector(".register-password");
const registerPasswordConfirm = registerModal.querySelector(".register-password-confirm");
const registerBtn = registerModal.querySelector(".registerBtn");

function toggleRegisterBtn() {
  const enabled =
    registerEmail.value.trim() !== "" &&
    registerPassword.value.trim() !== "" &&
    registerPasswordConfirm.value.trim() !== "";
    
  registerBtn.disabled = !enabled;
  if (enabled) {
    registerBtn.classList.remove("bg-neutral-40", "text-neutral-60");
    registerBtn.classList.add("bg-primary", "text-white");
  } else {
    registerBtn.classList.add("bg-neutral-40", "text-neutral-60");
    registerBtn.classList.remove("bg-primary", "text-white");
  }
}

registerEmail.addEventListener("input", toggleRegisterBtn);
registerPassword.addEventListener("input", toggleRegisterBtn);
registerPasswordConfirm.addEventListener("input", toggleRegisterBtn);
</script>

<!--輪播-->
<script>
   document.addEventListener("DOMContentLoaded", function () {
    // 找出所有存在的 swiper 容器
    const swiperContainers = document.querySelectorAll(".swiper");

    // 如果頁面上有輪播，才啟動
    if (swiperContainers.length > 0) {
      swiperContainers.forEach((container, index) => {
        new Swiper(container, {
          // 間距
          spaceBetween: 16,
          // 分頁
          pagination: {
            el: container.querySelector(".swiper-pagination"),
          },
          // 左右箭頭
          navigation: {
            nextEl: container.querySelector(".swiper-button-next"),
            prevEl: container.querySelector(".swiper-button-prev"),
          },
          // 滾動條
          scrollbar: {
            el: container.querySelector(".swiper-scrollbar"),
          },
          autoplay: true,
          slidesPerView: 3,

          // 響應式設定
          breakpoints: {
            0: {
              slidesPerView: 1,
            },
            768: {
              slidesPerView: 1,
            },
            992: {
              slidesPerView: 1,
            },
          },
        });
      });
    }
  });
</script>